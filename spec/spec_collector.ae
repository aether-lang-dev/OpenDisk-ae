// spec_collector.ae — OpenDisk's Collector, driven the ways a user fills
// it: a row's context menu ("Add to Collector"), a file drop on the window,
// Ctrl+Z to undo, a protected path refused with a notice, and Delete with
// its confirmation — which really deletes the fixture's files.
import std.spec
import std.string
import std.fs
import std.os (platform)
import od_driver
import uidriver

// On macOS the build wires od_collector's remover to macae's mac.trash (see
// od_app.ae's app_new), so deleting moves to the Trash instead of unlinking
// permanently — different confirmation copy and a differently-labelled
// confirm button.
is_macos() -> int {
    if string.equals(platform(), "darwin") == 1 { return 1 }
    return 0
}

// Context-menu item 0 on a list row is "Add to Collector".
collect_row(name: string) {
    r = od_driver.row_of(name)
    uidriver.post_ok("/widget/${r}/context_menu/0", string.concat("collect ", name))
}

drop(paths: string) {
    uidriver.post_ok("/window/filedrop?paths=${paths}", "file drop")
}

main() {
    fw = spec.init()
    od_driver.wait_for_app()
    fix = od_driver.fixture_path()

    spec.describe(fw, "OpenDisk: Collector") {
        spec.it("starts empty, with the hint and Delete disabled") callback {
            spec.assert_contains(od_driver.collector_title(), "Drag files here to collect them", "hint")
            del = uidriver.widget_id_of("button", "Delete")
            spec.assert_eq(uidriver.widget_bool_by_id(del, "enabled"), 0, "Delete disabled")
        }
        spec.it("collects a row from its context menu, and hides it from the list") callback {
            collect_row("Music")
            spec.assert_true(od_driver.wait_text("1 item collected", 20), "one item")
            spec.assert_str_eq(od_driver.list_names(), "Movies|Documents|tiny.txt", "Music hidden")
            del = uidriver.widget_id_of("button", "Delete")
            spec.assert_eq(uidriver.widget_bool_by_id(del, "enabled"), 1, "Delete enabled")
        }
        spec.it("undoes the last change with Ctrl+Z") callback {
            fired = uidriver.window_key("Ctrl+Z")
            spec.assert_eq(fired, 1, "Ctrl+Z handled")
            spec.assert_true(od_driver.wait_text("Drag files here", 20), "empty again")
            spec.assert_str_eq(od_driver.list_names(), "Movies|Music|Documents|tiny.txt", "Music back")
        }
        spec.it("collects files dropped on the window") callback {
            drop("${fix}/tiny.txt%0A${fix}/Documents/drafts")
            spec.assert_true(od_driver.wait_text("2 items collected", 20), "two items")
        }
        spec.it("refuses a protected folder and says why") callback {
            drop("/usr")
            spec.assert_true(od_driver.wait_text("can't be deleted", 20), "notice")
            spec.assert_contains(od_driver.text_containing("can't be deleted"), "usr", "names it")
            spec.assert_true(od_driver.wait_text("2 items collected", 5), "still two")
        }
        spec.it("asks before deleting, and Cancel keeps everything") callback {
            uidriver.click_widget(uidriver.widget_id_of("button", "Delete"))
            spec.assert_true(od_driver.wait_text("Delete 2 items?", 20), "confirmation")
            if is_macos() == 1 {
                spec.assert_true(od_driver.wait_text("moves the collected items to the Trash", 5), "says it goes to the Trash")
            } else {
                spec.assert_true(od_driver.wait_text("can’t be undone", 5), "says it is permanent")
            }
            uidriver.click_widget(uidriver.widget_id_of("button", "Cancel"))
            spec.assert_true(od_driver.wait_text("2 items collected", 20), "still collected")
            spec.assert_true(fs.exists("${fix}/tiny.txt"), "nothing deleted")
        }
        spec.it("deletes the collected items when confirmed (Trash on macOS, permanent elsewhere)") callback {
            uidriver.click_widget(uidriver.widget_id_of("button", "Delete"))
            spec.assert_true(od_driver.wait_text("Delete 2 items?", 20), "confirmation")
            // the confirm button is "Delete <total>" (or "Move to Trash: <total>" on macOS)
            confirm_prefix = "Delete "
            if is_macos() == 1 { confirm_prefix = "Move to Trash: " }
            confirm = od_driver.button_starting(confirm_prefix)
            spec.assert_true(confirm > 0, "a Delete/Move-to-Trash <size> button")
            spec.assert_contains(uidriver.widget_text_by_id(confirm), "KB", "it names the size")
            uidriver.click_widget(confirm)
            // one item per heartbeat: wait for the files to go
            i = 0
            while i < 60 {
                if fs.exists("${fix}/Documents/drafts") == 0 { i = 60 }
                sleep(100)
                i = i + 1
            }
            spec.assert_true(od_driver.wait_text("Freed", 40), "freed")
            spec.assert_false(fs.exists("${fix}/tiny.txt"), "tiny.txt gone from disk")
            spec.assert_false(fs.exists("${fix}/Documents/drafts"), "drafts gone from disk")
            spec.assert_true(fs.exists("${fix}/Movies/movie.mov"), "the rest untouched")
            spec.assert_true(od_driver.wait_scan_done(40), "rescanned after deleting")
        }
    }
    return spec.run_summary(fw)
}
