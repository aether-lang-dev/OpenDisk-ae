// OpenDisk formatters (port of FormattersTests + the byte-count rules
// OpenDisk gets from Foundation's ByteCountFormatter, pinned exactly so every
// platform prints the same).
import std.spec
import std.string
import od_fmt

main() {
    fw = spec.init()

    spec.describe(fw, "file_size: decimal units, adaptive precision") {
        spec.it("zero is 'Zero KB'") callback {
            spec.assert_true(string.starts_with(od_fmt.file_size(0), "Zero"), "starts with Zero")
            spec.assert_str_eq(od_fmt.file_size(0), "Zero KB", "exact")
        }
        spec.it("1024 bytes is 1 KB, 1024² is 1 MB, 1024³ is in GB") callback {
            spec.assert_str_eq(od_fmt.file_size(1024), "1 KB", "1 KiB")
            spec.assert_str_eq(od_fmt.file_size(1048576), "1 MB", "1 MiB")
            spec.assert_true(string.ends_with(od_fmt.file_size(1073741824), "GB"), "1 GiB in GB")
        }
        spec.it("KB has no decimals, MB one, GB and TB two, zeros dropped") callback {
            spec.assert_str_eq(od_fmt.file_size(1499), "1 KB", "1.499 KB rounds")
            spec.assert_str_eq(od_fmt.file_size(1500), "2 KB", "1.5 KB rounds up")
            spec.assert_str_eq(od_fmt.file_size(1500000), "1.5 MB", "1.5 MB")
            spec.assert_str_eq(od_fmt.file_size(1073741824), "1.07 GB", "1 GiB")
            spec.assert_str_eq(od_fmt.file_size(2500000000000), "2.5 TB", "2.5 TB")
        }
        spec.it("small sizes are bytes, and rounding carries into the next unit") callback {
            spec.assert_str_eq(od_fmt.file_size(1), "1 byte", "singular")
            spec.assert_str_eq(od_fmt.file_size(999), "999 bytes", "plural")
            spec.assert_str_eq(od_fmt.file_size(999999), "1 MB", "999,999 bytes")
        }
    }

    spec.describe(fw, "decimal_no_fraction: the device list's capacity") {
        spec.it("truncates the fraction instead of rounding") callback {
            spec.assert_str_eq(od_fmt.decimal_no_fraction(500000000000), "500 GB", "500 GB")
            spec.assert_str_eq(od_fmt.decimal_no_fraction(1500000000000), "1 TB", "1.5 TB")
            spec.assert_false(string.contains(od_fmt.decimal_no_fraction(1500000000000), "."), "no dot")
            spec.assert_false(string.contains(od_fmt.decimal_no_fraction(500000000000), "."), "no dot")
        }
    }

    spec.describe(fw, "scan_duration") {
        spec.it("under a second in ms, under a minute in seconds, else m:ss") callback {
            spec.assert_contains(od_fmt.scan_duration(0.5), "ms", "0.5s")
            spec.assert_str_eq(od_fmt.scan_duration(0.5), "Scanned in 500 ms", "exact ms")
            spec.assert_contains(od_fmt.scan_duration(3.2), "seconds", "3.2s")
            spec.assert_str_eq(od_fmt.scan_duration(3.2), "Scanned in 3.2 seconds", "exact s")
            spec.assert_contains(od_fmt.scan_duration(65.0), "1:05", "65s")
        }
    }

    spec.describe(fw, "counts") {
        spec.it("groups thousands and says item/items") callback {
            spec.assert_str_eq(od_fmt.grouped(1234567), "1,234,567", "grouped")
            spec.assert_str_eq(od_fmt.grouped(999), "999", "small")
            spec.assert_str_eq(od_fmt.plural_items(1), "1 item", "singular")
            spec.assert_str_eq(od_fmt.plural_items(2500), "2,500 items", "plural")
            spec.assert_str_eq(od_fmt.pct1(0.4), "40.0", "percent")
        }
    }
    return spec.run_summary(fw)
}
